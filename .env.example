# Conexión MySQL/MariaDB usada por Calendar en runtime y migraciones.
DATABASE_URL=

# Opcional: conexión directa alternativa para migraciones.
DIRECT_DATABASE_URL=

# Origen HTTPS público, por ejemplo https://calendar.example.com.
NEXTAUTH_URL=

# Genera un secreto único de producción con al menos 32 bytes aleatorios.
NEXTAUTH_SECRET=

# Opcional: define ambos valores para habilitar Zoho OAuth.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Notificaciones por correo con Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Calendar
RESEND_REPLY_TO=

# Secreto aleatorio de al menos 32 caracteres para el job de notificaciones.
NOTIFICATION_JOB_SECRET=

# Vercel Cron usa este secreto como Authorization: Bearer <valor>.
CRON_SECRET=

# Adjuntos de Registro de tarea en Cloudflare R2.
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGN_EXPIRES_SECONDS=900
# Alias compatible con instalaciones existentes, expresado en minutos.
R2_UPLOAD_EXPIRATION=

# Opcional: solo se usa al ejecutar manualmente el seed fuera del contenedor.
SEED_ADMIN_PASSWORD=
